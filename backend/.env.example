# BookKaroo Backend — .env.example
# Copy to backend/src/BookKaroo.Api/.env and fill in real values.
# NEVER commit the real .env file.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-...pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-...pooler.supabase.com:5432/postgres

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET_QR=qr-codes
SUPABASE_STORAGE_BUCKET_INVOICE=invoices

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-here
JWT_ISSUER=bookkaroo
JWT_AUDIENCE=bookkaroo-api
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ─── Payment ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx        # Phase 1.5
# RAZORPAY_KEY_SECRET=xxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx
# PAYPAL_MODE=sandbox                        # Phase 1.5 alternate
# PAYPAL_CLIENT_ID=xxxxxxxxx
# PAYPAL_CLIENT_SECRET=xxxxxxxxx
# PAYPAL_WEBHOOK_ID=xxxxxxxxx

# ─── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=BookKaroo <onboarding@bookkaroo.com>

# ─── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx
TMDB_BEARER=eyJhbGciOiJSUzI1NiJ9...

# ─── AI Chatbot (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_ENABLED=true

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
