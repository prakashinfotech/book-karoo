# Copy to .env (gitignored) and fill in. Used by all docker-compose files.

# ── Backend ──
DATABASE_URL=postgresql://user:password@host:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=bookkaroo
JWT_AUDIENCE=bookkaroo-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
RESEND_FROM=
TMDB_BEARER=
GROQ_API_KEY=
CHATBOT_ENABLED=false
ADMIN_EMAIL=
COMPANY_GSTIN=

# ── Frontend (baked in at build time) ──
# Public URL of the API as seen from the user's browser
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_ANON_KEY=
VITE_COMPANY_STATE_CODE=24
