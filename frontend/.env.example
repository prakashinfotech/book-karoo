# BookKaroo Frontend — .env.example
# Copy to .env and fill in. Never commit .env.
# All VITE_* vars are bundled into the frontend — only put PUBLIC values here.

# ─── API ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000

# ─── Supabase (Realtime + public reads) ───────────────────
VITE_SUPABASE_URL=https://[ref].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxx

# ─── Payment Provider (Phase 1 = mock) ────────────────────
VITE_PAYMENT_PROVIDER=mock
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx       # Phase 1.5
# VITE_PAYPAL_CLIENT_ID=xxxxxxxxx                # Phase 1.5 alternate

# ─── Maps (Phase 2) ───────────────────────────────────────
# VITE_GOOGLE_MAPS_API_KEY=xxxxxxxxx

# ─── Feature Flags ────────────────────────────────────────
VITE_ENABLE_VOICE_SEARCH=false
VITE_ENABLE_RECOMMENDATIONS=false
